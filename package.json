{
  "name": "hgbord",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./packages/shared --filter=./packages/database run build && pnpm -r --parallel --filter=./apps/* run dev",
    "build": "pnpm --filter @hgbord/shared build && pnpm --filter @hgbord/database build && pnpm -r --filter=./apps/* run build",
    "build:packages": "pnpm --filter @hgbord/shared build && pnpm --filter @hgbord/database build",
    "dev:admin": "pnpm --filter @hgbord/admin dev",
    "dev:api": "pnpm --filter @hgbord/api dev",
    "db:migrate": "pnpm --filter @hgbord/database prisma:migrate",
    "db:push": "pnpm --filter @hgbord/database prisma:push",
    "db:seed": "pnpm --filter @hgbord/database db:seed",
    "db:studio": "pnpm --filter @hgbord/database prisma studio",
    "prisma:generate": "pnpm --filter @hgbord/database prisma:generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
