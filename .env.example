# ===== 超级管理员账号（seed 用） =====
SEED_ADMIN_PHONE=18684593792
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=超级管理员

# ===== 后端 (apps/api) =====
# SQLite 数据库文件路径（相对 apps/api 目录）。原型阶段零配置。
DATABASE_URL="file:../../packages/database/prisma/dev.db"
# PostgreSQL 专用导入连接串（需要迁移到独立库时填写）
POSTGRES_DATABASE_URL="postgresql://postgres:password@localhost:5432/hgbord_prod?schema=public"
API_PORT=4000
# JWT 密钥 —— 生产环境务必换成长随机串
JWT_ACCESS_SECRET=change-me-access-secret-please-use-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32-chars
# Access Token 有效期
JWT_ACCESS_EXPIRES=15m
# Refresh Token 有效期
JWT_REFRESH_EXPIRES=7d

# ===== 前端 (apps/admin) =====
# 后端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:4000
